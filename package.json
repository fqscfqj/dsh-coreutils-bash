{
  "name": "dsh-coreutils-bash",
  "version": "1.1.0",
  "private": false,
  "description": "Native Bash execution on Windows backed by Microsoft Coreutils while retaining native PowerShell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fqscfqj/dsh-coreutils-bash.git"
  },
  "homepage": "https://github.com/fqscfqj/dsh-coreutils-bash#readme",
  "bugs": {
    "url": "https://github.com/fqscfqj/dsh-coreutils-bash/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "bash",
    "coreutils",
    "windows",
    "shell",
    "powershell",
    "pwsh"
  ],
  "type": "module",
  "main": "./executor.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./executor.js",
    "./executor": "./executor.js",
    "./terminal": "./terminal.js",
    "./resolve": "./resolve.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "executor.js",
    "terminal.js",
    "resolve.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "scripts": {
    "test": "node --test scripts/test-unit.mjs && node scripts/parse-patch.mjs",
    "test:runtime": "node scripts/test-resolve.mjs",
    "test:pwsh": "node scripts/test-pwsh.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-bash-local": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-pwsh-sandbox": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-pwsh-persistent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-terminal-bash": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
